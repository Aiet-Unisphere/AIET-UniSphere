# Browser-safe Supabase configuration (Public)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public OAuth application ID used to start GitHub OAuth in the browser
VITE_GITHUB_CLIENT_ID=

# Server-only secrets. Configure these via `supabase secrets set`; NEVER prefix with VITE_.
# Provider configuration:
AI_PROVIDER=gemini
GEMINI_MODEL=
GEMINI_API_KEY=

# Optional alternative provider:
OPENAI_MODEL=
OPENAI_API_KEY=

# GitHub integration secrets:
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Supabase administrative secret:
SUPABASE_SERVICE_ROLE_KEY=
