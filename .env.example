# Browser-safe Supabase configuration (Public)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public OAuth application ID used to start GitHub OAuth in the browser
# In development (port 5174), VITE_GITHUB_DEV_CLIENT_ID or VITE_GITHUB_CLIENT_ID is used.
# In production (Netlify), VITE_GITHUB_PROD_CLIENT_ID or VITE_GITHUB_CLIENT_ID is used.
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_DEV_CLIENT_ID=
VITE_GITHUB_PROD_CLIENT_ID=
# Optional explicit callback override (defaults to current origin + /student/github/callback):
# Local: http://localhost:5174/student/github/callback
# Production: https://aiet-unisphere.netlify.app/student/github/callback
VITE_GITHUB_CALLBACK_URL=

# Server-only secrets. Configure these via `supabase secrets set`; NEVER prefix with VITE_.
# Provider configuration:
AI_PROVIDER=gemini
GEMINI_MODEL=
GEMINI_API_KEY=

# Optional alternative provider:
OPENAI_MODEL=
OPENAI_API_KEY=

# GitHub integration secrets (configured on Supabase via `npx supabase secrets set`):
# Production GitHub OAuth credentials (callback: https://aiet-unisphere.netlify.app/student/github/callback):
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PROD_CLIENT_ID=
GITHUB_PROD_CLIENT_SECRET=

# Development GitHub OAuth credentials (callback: http://localhost:5174/student/github/callback):
GITHUB_DEV_CLIENT_ID=
GITHUB_DEV_CLIENT_SECRET=

# Local LLM Oracle Cloud Gateway secrets (Supabase Edge Function):
# Configure via: `npx supabase secrets set ORACLE_GATEWAY_URL=... ORACLE_GATEWAY_API_KEY=...`
# NEVER expose ORACLE_GATEWAY_API_KEY to the browser or prefix with VITE_.
ORACLE_GATEWAY_URL=
ORACLE_GATEWAY_API_KEY=
ORACLE_GATEWAY_TIMEOUT_MS=35000

# Optional frontend feature toggle (defaults to false if omitted):
# VITE_LOCAL_LLM_ENABLED=false

# Supabase administrative secret:
SUPABASE_SERVICE_ROLE_KEY=
